<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit the user form view to make phone required -->
        <record id="view_users_form_phone_required" model="ir.ui.view">
            <field name="name">res.users.form.phone.required</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Make phone field required in the form -->
                <field name="phone" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
            </field>
        </record>

        <!-- Also inherit the simplified user form (if exists) -->
        <record id="view_users_simple_form_phone_required" model="ir.ui.view">
            <field name="name">res.users.simple.form.phone.required</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_simple_form"/>
            <field name="arch" type="xml">
                <field name="phone" position="attributes">
                    <attribute name="required">1</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>