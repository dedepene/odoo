<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Guardian Views -->
    
    <!-- Guardian List View -->
    <record id="view_guardian_tree" model="ir.ui.view">
        <field name="name">guardian.guardian.tree</field>
        <field name="model">guardian.guardian</field>
        <field name="arch" type="xml">
            <list string="Guardians">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="kids_count"/>
                <field name="is_active"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Guardian Form View -->
    <record id="view_guardian_form" model="ir.ui.view">
        <field name="name">guardian.guardian.form</field>
        <field name="model">guardian.guardian</field>
        <field name="arch" type="xml">
            <form string="Guardian">
                <header>
                    <button name="toggle_active" type="object" string="Activate" 
                            invisible="is_active == True"
                            class="btn-primary"/>
                    <button name="toggle_active" type="object" string="Deactivate" 
                            invisible="is_active == False"
                            class="btn-secondary"/>
                    <field name="is_active" widget="boolean_button" 
                           options="{'terminology': 'active'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_kids" type="object" class="oe_stat_button" icon="fa-child">
                            <field name="kids_count" widget="statinfo" string="Kids"/>
                        </button>
                    </div>
                    
                    <group>
                        <group string="Personal Information">
                            <field name="name" placeholder="Full Name"/>
                            <field name="email" widget="email" placeholder="guardian@example.com"/>
                            <field name="phone" widget="phone" placeholder="+1-555-0123"/>
                            <field name="mobile" widget="phone" placeholder="+1-555-0123"/>
                        </group>
                        <group string="Account Information">
                            <field name="user_id" context="{'default_login': email}"/>
                            <field name="display_name"/>
                        </group>
                    </group>
                    
                    <group string="Address">
                        <field name="street" placeholder="Street Address"/>
                        <field name="street2" placeholder="Apt, Suite, etc."/>
                        <div class="o_address_format">
                            <field name="city" placeholder="City" style="width: 40%"/>
                            <field name="state_id" class="o_address_state" placeholder="State" style="width: 30%"/>
                            <field name="zip" placeholder="ZIP" style="width: 30%"/>
                        </div>
                        <field name="country_id" placeholder="Country"/>
                    </group>
                    
                    <notebook>
                        <page string="Kids" name="kids">
                            <field name="kid_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="gender"/>
                                    <field name="has_managed_account"/>
                                    <field name="guardians_count" string="Total Guardians"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kid Views -->
    
    <!-- Kid List View -->
    <record id="view_kid_tree" model="ir.ui.view">
        <field name="name">guardian.kid.tree</field>
        <field name="model">guardian.kid</field>
        <field name="arch" type="xml">
            <list string="Kids">
                <field name="name"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="has_managed_account"/>
                <field name="guardians_count"/>
                <field name="primary_guardian_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Kid Form View -->
    <record id="view_kid_form" model="ir.ui.view">
        <field name="name">guardian.kid.form</field>
        <field name="model">guardian.kid</field>
        <field name="arch" type="xml">
            <form string="Kid">
                <header>
                    <field name="active" widget="boolean_button" 
                           options="{'terminology': 'active'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_guardians" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="guardians_count" widget="statinfo" string="Guardians"/>
                        </button>
                    </div>
                    
                    <group>
                        <group string="Personal Information">
                            <field name="name" placeholder="Full Name"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                        </group>
                        <group string="Account Management">
                            <field name="has_managed_account"/>
                            <field name="user_id" invisible="has_managed_account == False"/>
                            <field name="email" invisible="has_managed_account == False" 
                                   widget="email" placeholder="kid@example.com"/>
                            <field name="phone" invisible="has_managed_account == False" 
                                   widget="phone"/>
                        </group>
                    </group>
                    
                    <group string="Guardian Information">
                        <field name="primary_guardian_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    
                    <notebook>
                        <page string="Guardians" name="guardians">
                            <field name="guardian_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="is_active" string="Active Account"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about this child..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Relationship Views -->
    
    <!-- Relationship List View -->
    <record id="view_relationship_tree" model="ir.ui.view">
        <field name="name">guardian.kid.relationship.tree</field>
        <field name="model">guardian.kid.relationship</field>
        <field name="arch" type="xml">
            <list string="Guardian-Kid Relationships">
                <field name="guardian_id"/>
                <field name="kid_id"/>
                <field name="relationship_type"/>
                <field name="has_legal_custody"/>
                <field name="emergency_contact"/>
                <field name="active"/>
                <field name="relationship_start_date"/>
            </list>
        </field>
    </record>

    <!-- Relationship Form View -->
    <record id="view_relationship_form" model="ir.ui.view">
        <field name="name">guardian.kid.relationship.form</field>
        <field name="model">guardian.kid.relationship</field>
        <field name="arch" type="xml">
            <form string="Guardian-Kid Relationship">
                <header>
                    <field name="active" widget="boolean_button" 
                           options="{'terminology': 'active'}"/>
                </header>
                <sheet>
                    <group>
                        <group string="Relationship">
                            <field name="guardian_id"/>
                            <field name="kid_id"/>
                            <field name="relationship_type"/>
                            <field name="relationship_start_date"/>
                            <field name="relationship_end_date"/>
                        </group>
                        <group string="Permissions &amp; Contact">
                            <field name="has_legal_custody"/>
                            <field name="can_pick_up"/>
                            <field name="emergency_contact"/>
                            <field name="can_make_decisions"/>
                            <field name="preferred_contact_method"/>
                        </group>
                    </group>
                    
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional notes about this relationship..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    
    <!-- Guardian Action -->
    <record id="action_guardian" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">guardian.guardian</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first guardian!
            </p>
            <p>
                Guardians are parents or legal guardians who have active accounts and are responsible for managing kids.
            </p>
        </field>
    </record>

    <!-- Kid Action -->
    <record id="action_kid" model="ir.actions.act_window">
        <field name="name">Kids</field>
        <field name="res_model">guardian.kid</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first kid!
            </p>
            <p>
                Kids can have managed accounts or be managed through their guardians' accounts.
            </p>
        </field>
    </record>

    <!-- Relationship Action -->
    <record id="action_relationship" model="ir.actions.act_window">
        <field name="name">Guardian-Kid Relationships</field>
        <field name="res_model">guardian.kid.relationship</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define relationships between guardians and kids!
            </p>
            <p>
                Track detailed relationship information including legal custody, permissions, and contact preferences.
            </p>
        </field>
    </record>

    <!-- Actions -->
    
    <!-- Guardian Actions -->
    <record id="action_guardian_list" model="ir.actions.act_window">
        <field name="name">Guardians</field>
        <field name="res_model">guardian.guardian</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first guardian!
            </p>
            <p>
                Guardians are the parents or legal guardians responsible for kids.
            </p>
        </field>
    </record>

    <!-- Kid Actions -->
    <record id="action_kid_list" model="ir.actions.act_window">
        <field name="name">Kids</field>
        <field name="res_model">guardian.kid</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first kid!
            </p>
            <p>
                Kids are the children being managed by guardians.
            </p>
        </field>
    </record>

    <!-- Relationship Actions -->
    <record id="action_relationship_list" model="ir.actions.act_window">
        <field name="name">Guardian-Kid Relationships</field>
        <field name="res_model">guardian.kid.relationship</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Structure -->
    
    <!-- Main Menu -->
    <menuitem id="menu_guardian_main" name="Guardian Management" sequence="10"/>
    
    <!-- Sub Menus -->
    <menuitem id="menu_guardian_guardians" name="Guardians" parent="menu_guardian_main" 
              action="action_guardian_list" sequence="10"/>
    <menuitem id="menu_guardian_kids" name="Kids" parent="menu_guardian_main" 
              action="action_kid_list" sequence="20"/>
    <menuitem id="menu_guardian_relationships" name="Relationships" parent="menu_guardian_main" 
              action="action_relationship_list" sequence="30"/>

    <!-- Search Views -->
    
    <!-- Guardian Search -->
    <record id="view_guardian_search" model="ir.ui.view">
        <field name="name">guardian.guardian.search</field>
        <field name="model">guardian.guardian</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
            </search>
        </field>
    </record>

    <!-- Kid Search -->
    <record id="view_kid_search" model="ir.ui.view">
        <field name="name">guardian.kid.search</field>
        <field name="model">guardian.kid</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

</odoo>