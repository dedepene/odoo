<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_weekly_schedule_wizard_form" model="ir.ui.view">
        <field name="name">academy.weekly.schedule.wizard.form</field>
        <field name="model">academy.weekly.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Session Templates">
                <sheet>
                    <group>
                        <field name="season_id" readonly="1"/>
                    </group>
                    <group string="Select Templates to Schedule">
                        <p>Select which templates to generate session occurrences for. All templates are shown as read-only. To create or edit templates, use the Session Templates menu.</p>
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="template_id" column_invisible="1"/>
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="multi_skill_mode" optional="show"/>
                                <field name="skill_group_id" optional="show"/>
                                <field name="skill_group_ids" widget="many2many_tags" optional="show"/>
                                <field name="day_of_week"/>
                                <field name="start_time" widget="float_time"/>
                                <field name="end_time" widget="float_time"/>
                                <field name="session_type"/>
                                <field name="court_ids" widget="many2many_tags"/>
                                <field name="coach_id"/>
                                <field name="occurrence_count" string="Already Scheduled"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" string="Apply &amp; Generate Sessions" 
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
