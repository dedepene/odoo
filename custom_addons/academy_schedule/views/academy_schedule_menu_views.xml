<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Scheduling Menu -->
    <menuitem id="menu_academy_schedule_root"
              name="Scheduling"
              parent="academy_core.menu_academy_root"
              sequence="20"/>

    <!-- Today's Sessions - Primary coach workspace (at the top) -->
    <menuitem id="menu_academy_today_sessions"
              name="Today's Sessions"
              parent="menu_academy_schedule_root"
              action="action_academy_today_sessions"
              sequence="5"
              groups="academy_core.group_academy_coach,academy_core.group_academy_head_coach,academy_core.group_academy_site_admin"/>

    <!-- All Sessions -->
    <menuitem id="menu_academy_session_occurrence"
              name="All Sessions"
              parent="menu_academy_schedule_root"
              action="action_academy_session_occurrence"
              sequence="30"/>

    <!-- Suspensions -->
    <menuitem id="menu_academy_season_suspension"
              name="Suspensions"
              parent="menu_academy_schedule_root"
              action="action_academy_season_suspension"
              sequence="35"/>

    <!-- Absences -->
    <menuitem id="menu_academy_session_absence"
              name="Absences"
              parent="menu_academy_schedule_root"
              action="action_academy_session_absence"
              sequence="40"/>

    <!-- Individual Session Booking Action (accessible from menu or button) -->
    <menuitem id="menu_academy_individual_session"
              name="Book Individual Session"
              parent="menu_academy_schedule_root"
              action="action_individual_session_wizard"
              sequence="45"/>

    <!-- Configuration Submenu (under Scheduling) -->
    <menuitem id="menu_academy_schedule_config"
              name="Configuration"
              parent="menu_academy_schedule_root"
              sequence="100"/>

    <!-- Courts -->
    <menuitem id="menu_academy_court"
              name="Courts"
              parent="menu_academy_schedule_config"
              action="action_academy_court"
              sequence="10"/>
</odoo>
