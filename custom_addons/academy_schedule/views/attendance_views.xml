<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance Tree View -->
    <record id="view_academy_attendance_tree" model="ir.ui.view">
        <field name="name">academy.attendance.tree</field>
        <field name="model">academy.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance Records" create="false" delete="false">
                <field name="name"/>
                <field name="player_id"/>
                <field name="session_id"/>
                <field name="session_date"/>
                <field name="session_type"/>
                <field name="skill_group_id"/>
                <field name="state" widget="badge" decoration-success="state=='present'"/>
                <field name="is_walkin" widget="boolean_toggle"/>
                <field name="walkin_reason" optional="hide"/>
                <field name="marked_by_id"/>
                <field name="confirmation_time"/>
                <field name="is_billed" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_academy_attendance_form" model="ir.ui.view">
        <field name="name">academy.attendance.form</field>
        <field name="model">academy.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Record" create="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Walk-In" bg_color="text-bg-warning" invisible="not is_walkin"/>
                    <widget name="web_ribbon" title="Billed" bg_color="text-bg-success" invisible="not is_billed"/>
                    <group>
                        <group>
                            <field name="player_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="session_date" readonly="1"/>
                            <field name="session_type" readonly="1"/>
                            <field name="skill_group_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="marked_by_id" readonly="1"/>
                            <field name="confirmation_time" readonly="1"/>
                            <field name="is_walkin" readonly="1"/>
                            <field name="walkin_reason" invisible="not is_walkin" readonly="1"/>
                            <field name="billing_item_id" invisible="1"/>
                            <field name="is_billed" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Attendance Search View -->
    <record id="view_academy_attendance_search" model="ir.ui.view">
        <field name="name">academy.attendance.search</field>
        <field name="model">academy.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="player_id"/>
                <field name="session_id"/>
                <field name="session_date"/>
                <filter name="filter_present" string="Present" domain="[('state', '=', 'present')]"/>
                <filter name="filter_walkin" string="Walk-In" domain="[('is_walkin', '=', True)]"/>
                <filter name="filter_billed" string="Billed" domain="[('is_billed', '=', True)]"/>
                <filter name="filter_unbilled" string="Not Billed" domain="[('is_billed', '=', False)]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month" 
                        domain="[('session_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('session_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_player" string="Player" context="{'group_by': 'player_id'}"/>
                <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                <filter name="group_skill_group" string="Skill Group" context="{'group_by': 'skill_group_id'}"/>
                <filter name="group_session_type" string="Session Type" context="{'group_by': 'session_type'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'session_date'}"/>
            </search>
        </field>
    </record>

    <!-- Attendance Action -->
    <record id="action_academy_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">academy.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records yet
            </p>
            <p>
                Attendance records are created when coaches confirm session attendance.
            </p>
        </field>
    </record>

    <!-- Billing Item Tree View -->
    <record id="view_academy_billing_item_tree" model="ir.ui.view">
        <field name="name">academy.billing.item.tree</field>
        <field name="model">academy.billing.item</field>
        <field name="arch" type="xml">
            <list string="Billing Items">
                <field name="name"/>
                <field name="player_id"/>
                <field name="session_date"/>
                <field name="session_type"/>
                <field name="primary_guardian_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_walkin" widget="boolean_toggle"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='pending'"
                       decoration-success="state=='approved'"
                       decoration-warning="state=='invoiced'"
                       decoration-muted="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Billing Item Form View -->
    <record id="view_academy_billing_item_form" model="ir.ui.view">
        <field name="name">academy.billing.item.form</field>
        <field name="model">academy.billing.item</field>
        <field name="arch" type="xml">
            <form string="Billing Item">
                <header>
                    <button name="action_approve" string="Approve" type="object" 
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            class="btn-secondary" invisible="state not in ['pending', 'approved']"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,invoiced"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Walk-In" bg_color="text-bg-warning" invisible="not is_walkin"/>
                    <widget name="web_ribbon" title="Auto-Generated" bg_color="text-bg-info" invisible="not created_by_cron"/>
                    <group>
                        <group>
                            <field name="player_id"/>
                            <field name="session_id"/>
                            <field name="session_date"/>
                            <field name="session_type"/>
                            <field name="attendance_id"/>
                        </group>
                        <group>
                            <field name="primary_guardian_id"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_walkin"/>
                            <field name="walkin_reason" invisible="not is_walkin"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="invoice_line_id" invisible="1"/>
                            <field name="created_by_cron" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Billing notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Billing Item Search View -->
    <record id="view_academy_billing_item_search" model="ir.ui.view">
        <field name="name">academy.billing.item.search</field>
        <field name="model">academy.billing.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="player_id"/>
                <field name="primary_guardian_id"/>
                <field name="session_id"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <filter name="filter_walkin" string="Walk-In" domain="[('is_walkin', '=', True)]"/>
                <separator/>
                <filter name="filter_this_month" string="This Month" 
                        domain="[('session_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('session_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_player" string="Player" context="{'group_by': 'player_id'}"/>
                <filter name="group_guardian" string="Guardian" context="{'group_by': 'primary_guardian_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'session_date'}"/>
            </search>
        </field>
    </record>

    <!-- Billing Item Action -->
    <record id="action_academy_billing_item" model="ir.actions.act_window">
        <field name="name">Billing Items</field>
        <field name="res_model">academy.billing.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1, 'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No billing items yet
            </p>
            <p>
                Billing items are generated from confirmed attendance records.
            </p>
        </field>
    </record>

    <!-- Session Participant Tree View -->
    <record id="view_academy_session_participant_tree" model="ir.ui.view">
        <field name="name">academy.session.participant.tree</field>
        <field name="model">academy.session.participant</field>
        <field name="arch" type="xml">
            <list string="Session Participants" create="false">
                <field name="session_id"/>
                <field name="player_id"/>
                <field name="is_walkin" widget="boolean_toggle"/>
                <field name="walkin_reason" optional="hide"/>
                <field name="added_by_id" optional="show"/>
                <field name="added_date"/>
            </list>
        </field>
    </record>

    <!-- Session Participant Form View -->
    <record id="view_academy_session_participant_form" model="ir.ui.view">
        <field name="name">academy.session.participant.form</field>
        <field name="model">academy.session.participant</field>
        <field name="arch" type="xml">
            <form string="Session Participant" create="false">
                <sheet>
                    <widget name="web_ribbon" title="Walk-In" bg_color="text-bg-warning" invisible="not is_walkin"/>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="player_id"/>
                        </group>
                        <group>
                            <field name="is_walkin"/>
                            <field name="walkin_reason" invisible="not is_walkin"/>
                            <field name="added_by_id"/>
                            <field name="added_date"/>
                        </group>
                    </group>
                    <group string="Notes" invisible="not walkin_reason_note">
                        <field name="walkin_reason_note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Attendance Menu Items -->
    <menuitem id="menu_academy_attendance_root"
              name="Attendance"
              parent="academy_schedule.menu_academy_schedule_root"
              sequence="30"/>

    <menuitem id="menu_academy_attendance"
              name="Attendance Records"
              parent="menu_academy_attendance_root"
              action="action_academy_attendance"
              sequence="10"/>

    <menuitem id="menu_academy_billing_items"
              name="Billing Items"
              parent="menu_academy_attendance_root"
              action="action_academy_billing_item"
              sequence="20"/>

</odoo>
