                <filter name="group" string="Group" domain="[('is_individual', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_skill_group" string="Skill Group" context="{'group_by': 'skill_group_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    -->

    <record id="action_academy_session_occurrence" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">academy.session.occurrence</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>
