<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academy_session_occurrence_tree" model="ir.ui.view">
        <field name="name">academy.session.occurrence.list</field>
        <field name="model">academy.session.occurrence</field>
        <field name="arch" type="xml">
            <list string="Sessions" decoration-muted="state == 'cancelled'" 
                decoration-warning="state == 'suspended'">
                <field name="name"/>
                <field name="start_datetime"/>
                <field name="skill_group_id"/>
                <field name="session_type"/>
                <field name="court_ids" widget="many2many_tags"/>
                <field name="coach_id"/>
                <field name="absence_count"/>
                <field name="state" widget="badge"/>
                <field name="suspension_reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_academy_session_occurrence_form" model="ir.ui.view">
        <field name="name">academy.session.occurrence.form</field>
        <field name="model">academy.session.occurrence</field>
        <field name="arch" type="xml">
            <form string="Session">
                <header>
                    <button name="action_confirm_attendance" string="Confirm Attendance" type="object" 
                            class="oe_highlight" 
                            invisible="state != 'planned' or attendance_status == 'confirmed' or is_individual"
                            help="Confirm which players attended this session"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            class="btn btn-danger" invisible="state != 'planned'"/>
                    <button name="action_reactivate" string="Reactivate" type="object" 
                            invisible="state not in ['cancelled', 'suspended']"/>
                    <button name="action_complete" string="Mark Complete" type="object" 
                            class="oe_highlight" invisible="state != 'planned'"/>
                    <button name="action_report_absence" string="Report Absence" type="object" 
                            invisible="is_individual"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="planned,suspended,cancelled,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_absences" type="object" 
                                class="oe_stat_button" icon="fa-times-circle" 
                                invisible="is_individual">
                            <field name="absence_count" widget="statinfo" string="Absences"/>
                        </button>
                        <button name="%(academy_schedule.action_academy_attendance)d" type="action" 
                                class="oe_stat_button" icon="fa-check-square"
                                context="{'search_default_session_id': id}"
                                invisible="attendance_count == 0">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Attendance Confirmed" bg_color="text-bg-success" 
                            invisible="attendance_status != 'confirmed'"/>
                    <group>
                        <group>
                            <field name="template_id" readonly="1"/>
                            <field name="season_id"/>
                            <field name="date"/>
                            <field name="skill_group_id" invisible="is_individual"/>
                            <field name="player_ids" widget="many2many_tags" invisible="not is_individual"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="session_type"/>
                            <field name="court_ids" widget="many2many_tags"/>
                            <field name="coach_id"/>
                            <field name="is_individual"/>
                            <field name="is_followup"/>
                            <field name="suspension_reason" readonly="1" invisible="state != 'suspended'"/>
                            <field name="attendance_status" readonly="1" invisible="is_individual"/>
                        </group>
                    </group>
                    <group invisible="state != 'suspended'">
                        <field name="suspension_id" readonly="1"/>
                        <field name="state_before_suspension" readonly="1"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_academy_session_occurrence_calendar" model="ir.ui.view">
        <field name="name">academy.session.occurrence.calendar</field>
        <field name="model">academy.session.occurrence</field>
        <field name="arch" type="xml">
            <calendar string="Sessions" date_start="start_datetime" date_stop="end_datetime" 
                      color="skill_group_id" mode="week">
                <field name="name"/>
                <field name="skill_group_id"/>
                <field name="court_ids"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_academy_session_occurrence_search" model="ir.ui.view">
        <field name="name">academy.session.occurrence.search</field>
        <field name="model">academy.session.occurrence</field>
        <field name="arch" type="xml">
            <search string="Sessions">
                <field name="name"/>
                <field name="skill_group_id"/>
                <field name="coach_id"/>
                <field name="court_ids"/>
                <separator/>
                <filter name="future_sessions"
                        string="Upcoming"
                        help="Show sessions starting today or later"
                        domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="past_sessions"
                        string="Past Sessions"
                        help="Show sessions that started before today"
                        domain="[('start_datetime', '&lt;', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="suspended" string="Suspended" domain="[('state', '=', 'suspended')]"/>
                <filter name="individual" string="Individual" domain="[('is_individual', '=', True)]"/>
                <filter name="group" string="Group" domain="[('is_individual', '=', False)]"/>
                <group>
                    <filter name="group_by_skill_group" string="Skill Group" context="{'group_by': 'skill_group_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_academy_session_occurrence" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">academy.session.occurrence</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_future_sessions': 1}</field>
    </record>

    <!-- Today's Sessions - Filtered view for coaches -->
    <record id="action_academy_today_sessions" model="ir.actions.act_window">
        <field name="name">Today's Sessions</field>
        <field name="res_model">academy.session.occurrence</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                               ('start_datetime', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]</field>
        <field name="context">{'default_start_datetime': context_today()}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sessions scheduled for today
            </p>
            <p>
                Sessions scheduled for today will appear here.<br/>
                This is your primary workspace for attendance validation.
            </p>
        </field>
    </record>
</odoo>
