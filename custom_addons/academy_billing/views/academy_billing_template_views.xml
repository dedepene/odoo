<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academy_billing_template_tree" model="ir.ui.view">
            <field name="name">academy.billing.template.tree</field>
            <field name="model">academy.billing.template</field>
            <field name="arch" type="xml">
                <list string="Billing Templates">
                    <field name="name"/>
                    <field name="invoice_generation_day"/>
                    <field name="payment_due_days"/>
                    <field name="is_default" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_academy_billing_template_form" model="ir.ui.view">
            <field name="name">academy.billing.template.form</field>
            <field name="model">academy.billing.template</field>
            <field name="arch" type="xml">
                <form string="Billing Template">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    class="oe_stat_button"
                                    icon="fa-calendar"
                                    name="action_view_session_templates">
                                <field name="session_template_ids" string="Session Templates" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="description" widget="text" nolabel="1" readonly="1"/>
                            </group>
                            <group>
                                <field name="invoice_generation_day"/>
                                <field name="payment_due_days"/>
                                <field name="is_default"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_academy_billing_template" model="ir.actions.act_window">
            <field name="name">Billing Templates</field>
            <field name="res_model">academy.billing.template</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
