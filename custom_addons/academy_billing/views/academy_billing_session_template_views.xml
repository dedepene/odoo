<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academy_session_template_tree_inherit_billing" model="ir.ui.view">
            <field name="name">academy.session.template.tree.inherit.billing</field>
            <field name="model">academy.session.template</field>
            <field name="inherit_id" ref="academy_schedule.view_academy_session_template_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='session_type']" position="after">
                    <field name="billing_template_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_academy_session_template_form_inherit_billing" model="ir.ui.view">
            <field name="name">academy.session.template.form.inherit.billing</field>
            <field name="model">academy.session.template</field>
            <field name="inherit_id" ref="academy_schedule.view_academy_session_template_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group[1]" position="inside">
                    <field name="billing_template_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
