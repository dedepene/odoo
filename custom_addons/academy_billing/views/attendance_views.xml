<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academy_attendance_tree_inherit_billing" model="ir.ui.view">
            <field name="name">academy.attendance.tree.inherit.billing</field>
            <field name="model">academy.attendance</field>
            <field name="inherit_id" ref="academy_schedule.view_academy_attendance_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='confirmation_time']" position="after">
                    <field name="is_billed" widget="boolean"/>
                </xpath>
            </field>
        </record>

        <record id="view_academy_attendance_form_inherit_billing" model="ir.ui.view">
            <field name="name">academy.attendance.form.inherit.billing</field>
            <field name="model">academy.attendance</field>
            <field name="inherit_id" ref="academy_schedule.view_academy_attendance_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <widget name="web_ribbon" title="Billed" bg_color="text-bg-success" modifiers="{'invisible': [('is_billed', '=', False)]}"/>
                </xpath>
                <xpath expr="//group/group[last()]" position="inside">
                    <field name="billing_item_id" modifiers="{'invisible': True}"/>
                    <field name="is_billed" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="view_academy_attendance_search_inherit_billing" model="ir.ui.view">
            <field name="name">academy.attendance.search.inherit.billing</field>
            <field name="model">academy.attendance</field>
            <field name="inherit_id" ref="academy_schedule.view_academy_attendance_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="filter_billed" string="Billed" domain="[('is_billed', '=', True)]"/>
                    <filter name="filter_unbilled" string="Not Billed" domain="[('is_billed', '=', False)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
