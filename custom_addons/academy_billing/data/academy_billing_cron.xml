<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_reconcile_monthly_absences" model="ir.cron">
            <field name="name">Academy: Reconcile Acknowledged Absences</field>
            <field name="model_id" ref="model_academy_billing_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_reconcile_monthly_absences()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(months=1, day=1, hour=3, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="cron_generate_monthly_prepaid_invoices" model="ir.cron">
            <field name="name">Academy: Generate Monthly Pre-Paid Invoices</field>
            <field name="model_id" ref="model_academy_billing_template"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_monthly_prepaid_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=1, hour=4, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
