<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_academy" model="ir.module.category">
            <field name="name">Academy</field>
            <field name="description">Tennis academy management</field>
            <field name="sequence">10</field>
        </record>

        <record id="res_groups_privilege_academy" model="res.groups.privilege">
            <field name="name">Academy</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="academy_core.module_category_academy"/>
        </record>

        <record id="group_academy_guardian" model="res.groups">
            <field name="name">Academy Guardian</field>
            <field name="comment">Portal guardians for academy players.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="privilege_id" ref="academy_core.res_groups_privilege_academy"/>
        </record>

        <record id="group_academy_player_portal" model="res.groups">
            <field name="name">Academy Player Portal</field>
            <field name="comment">Elevated player accounts with limited portal access.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
            <field name="privilege_id" ref="academy_core.res_groups_privilege_academy"/>
        </record>

        <record id="group_academy_coach" model="res.groups">
            <field name="name">Academy Coach</field>
            <field name="comment">Coaches with access to assigned players and sessions.</field>
            <field name="privilege_id" ref="academy_core.res_groups_privilege_academy"/>
        </record>

        <record id="group_academy_head_coach" model="res.groups">
            <field name="name">Academy Head Coach</field>
            <field name="comment">Head coaches with scheduling authority.</field>
            <field name="implied_ids" eval="[(4, ref('academy_core.group_academy_coach'))]"/>
            <field name="privilege_id" ref="academy_core.res_groups_privilege_academy"/>
        </record>

        <record id="group_academy_site_admin" model="res.groups">
            <field name="name">Academy Site Admin</field>
            <field name="comment">Site administrators with configuration powers.</field>
            <field name="privilege_id" ref="academy_core.res_groups_privilege_academy"/>
        </record>
    </data>
</odoo>
