<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal home card: Practice -->
        <template id="portal_my_home_practice" name="Portal layout : Practice" inherit_id="portal.portal_my_home" priority="30">
            <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
                <t t-set="portal_practice_enable" t-value="True"/>
            </xpath>
            <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                    <t t-set="title">Practice</t>
                    <t t-set="url" t-value="'/my/practice'"/>
                    <t t-set="text">View your child's upcoming sessions and report absences</t>
                </t>
            </xpath>
        </template>

        <!-- Practice page listing children and occurrences -->
        <template id="portal_my_practice" name="My Practice">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Practice</t>
                </t>

                <div class="container mt-4">
                    <t t-if="not players">
                        <div class="alert alert-warning">No children are linked to your account.</div>
                    </t>
                    <t t-foreach="players" t-as="player">
                        <div class="card mb-3">
                            <div class="card-header">
                                <h5 t-out="player.name"/>
                            </div>
                            <div class="card-body">
                                <t t-set="occs" t-value="occurrences_by_player.get(player.id)"/>
                                <t t-if="not occs">
                                    <p>No upcoming sessions.</p>
                                </t>
                                <t t-if="occs">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Time</th>
                                                <th>Session</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="occs" t-as="o">
                                                <tr>
                                                    <td><span t-field="o.date"/></td>
                                                    <td>
                                                        <t t-if="o.start_datetime and o.end_datetime">
                                                            <span t-esc="o.start_datetime.strftime('%H:%M')"/> - <span t-esc="o.end_datetime.strftime('%H:%M')"/>
                                                        </t>
                                                    </td>
                                                    <td><t t-esc="o.template_id.name or o.name"/></td>
                                                    <td>
                                                        <form action="/my/practice/report_absence" method="post">
                                                            <input type="hidden" name="occurrence_id" t-att-value="o.id"/>
                                                            <input type="hidden" name="player_id" t-att-value="player.id"/>
                                                            <button class="btn btn-outline-danger btn-sm" type="submit">Report Absence</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </template>
            <!-- Override existing Orders tile (sale) to show Practice instead -->
            <template id="portal_my_home_sale_override" name="Override Orders to Practice" inherit_id="sale.portal_my_home_sale" priority="5">
                <xpath expr="//div[@id='portal_client_category']/t" position="replace">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                        <t t-set="title">Practice</t>
                        <t t-set="url" t-value="'/my/practice'"/>
                        <t t-set="text">View your child's upcoming sessions and report absences</t>
                        <t t-set="placeholder_count" t-value="'order_count'"/>
                    </t>
                </xpath>
            </template>
        </data>
    </odoo>
