<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_academy_skill_group_list" model="ir.ui.view">
            <field name="name">academy.skill.group.list</field>
            <field name="model">academy.skill.group</field>
            <field name="arch" type="xml">
                <list string="Skill Groups" default_order="sequence">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="min_age"/>
                    <field name="max_age"/>
                    <field name="enforce_age_range"/>
                    <field name="capacity"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_academy_skill_group_form" model="ir.ui.view">
            <field name="name">academy.skill.group.form</field>
            <field name="model">academy.skill.group</field>
            <field name="arch" type="xml">
                <form string="Skill Group">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="min_age"/>
                                <field name="max_age"/>
                                <field name="enforce_age_range"/>
                                <field name="capacity"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_academy_skill_group" model="ir.actions.act_window">
            <field name="name">Skill Groups</field>
            <field name="res_model">academy.skill.group</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create skill group definitions matching the academy curriculum.
                </p>
            </field>
        </record>
    </data>
</odoo>
